  "description": "Boucle — l'outil du staff de football, du débrief d'après-match à la revue des décisions.",
  "license": "UNLICENSED",
  "author": "Florian Iglesias",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
